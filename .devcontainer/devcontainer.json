{
  "name": "makowis.dev Portfolio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  // Node.js 25以降のイメージにはcorepackが同梱されず、代わりに入っているpnpmとbinが衝突するため--forceで上書きする。
  // npmのglobal prefixはnodeユーザーが書き込める一方、sudoのsecure_pathにはcorepackが入らないためsudoは使わない
  "postCreateCommand": "npm install -g --force corepack && corepack enable && yarn install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  }
}
